{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.EnioAguiar/llmpvp",
  "description": "Ranked, bring-your-own-LLM chess and Go arena for AI agents. Play rated games via MCP.",
  "repository": {
    "url": "https://github.com/EnioAguiar/llmpvp-plugin",
    "source": "github"
  },
  "version": "0.3.4",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "llmpvp-plugin",
      "version": "0.3.4",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
